    #: Text-ish fields the ?q= box searches. Introspected at generate time.
    #: Widen it by hand if a related field should be searchable too.
    SEARCH_FIELDS = [[ searchable_fields ]]

    def get_queryset(self):
        """Filter on ?q=, server-side.

        Words are ANDed and fields are ORed, so "ada lovelace" matches a row
        holding "Ada" in one field and "Lovelace" in another. This replaces a
        hyperscript filter that only hid rows already on the page, and so lied
        on every list past page one.

        distinct() matters the moment SEARCH_FIELDS is widened to span a join:
        without it one row comes back once per matching related row.
        """
        queryset = super([[ model_name ]]ListView, self).get_queryset()
[% if list_related_args %]
        # These relations are on the page for every row, so without this the
        # list issues one extra query per row per relation.
        queryset = queryset.select_related([[ list_related_args ]])
[% endif %]
        term = self.request.GET.get("q", "").strip()
        if not term or not self.SEARCH_FIELDS:
            return queryset
        for word in term.split():
            clause = Q()
            for field in self.SEARCH_FIELDS:
                clause |= Q(**{"%s__icontains" % field: word})
            queryset = queryset.filter(clause)
        return queryset.distinct()

